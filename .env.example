# ══════════════════════════════════════════════════════
# AECMI — Variables de entorno
# Copia este archivo como .env.local y rellena los valores
#   cp .env.example .env.local
# ══════════════════════════════════════════════════════

# ── SUPABASE ───────────────────────────────────────────
# Supabase Dashboard → Settings → API

# URL de tu proyecto (pública, va al cliente)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clave anónima — solo permisos RLS (pública, va al cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── EMAIL (RESEND) ─────────────────────────────────────
# resend.com → Dashboard → API Keys
RESEND_API_KEY=re_your_api_key_here

# ── STRIPE ────────────────────────────────────────────
# dashboard.stripe.com → Developers → API keys
# Use sk_test_*/pk_test_* in local, sk_live_*/pk_live_* in Vercel prod
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# dashboard.stripe.com → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── SENTRY ─────────────────────────────────────────────
# sentry.io → Settings → Projects → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://your_key@sentry.io/your_project_id
SENTRY_DSN=https://your_key@sentry.io/your_project_id
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=aecmi-platform
# sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN=sntrys_your_auth_token_here
