# ══════════════════════════════════════════════════════
# AECMI — Variables de entorno
# Copia este archivo como .env.local y rellena los valores
#   cp .env.example .env.local
# ══════════════════════════════════════════════════════

# ── SUPABASE ───────────────────────────────────────────
# Supabase Dashboard → Settings → API

# URL de tu proyecto (pública, va al cliente)
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima — solo permisos RLS (pública, va al cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio — bypasea RLS, NUNCA expongas al cliente
# Usar únicamente en scripts de servidor / seed
SUPABASE_SERVICE_ROLE_KEY=
